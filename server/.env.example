# Genova Healthcare OS — Server Environment Configuration

# Server Port & Environment
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas connection string or local MongoDB instance)
MONGODB_URI=mongodb://127.0.0.1:27017/genova

# Fallback to embedded in-memory MongoDB for local evaluation and automated testing
USE_MEMORY_DB_IF_UNAVAILABLE=true

# Authentication & Session Security (Replace with a strong random 256-bit secret)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# CORS & Frontend Origins (Allowed origin for cookies and credentials)
FRONTEND_ORIGIN=http://localhost:5173

# Google OAuth 2.0 Client ID (Backend verification of Google Identity Services tokens)
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com

# AI Assistant Configuration (Optional: Gemini or mock)
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-1.5-flash

# Storage & Upload Limits
MAX_FILE_SIZE_MB=15
